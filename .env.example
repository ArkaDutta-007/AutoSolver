# Copy to .env and chmod 600 it. .env is gitignored; never commit real keys.
# Every line is optional: an unset variable falls back to the default in
# src/config.py, and every remote service degrades to the local path.

# --- Local models (Ollama) ---------------------------------------------------
OLLAMA_BASE=http://127.0.0.1:11434/v1
# Orchestrator: plans, explores, writes Lean signatures. It also reviews
# (REVIEWER_MODEL defaults to it) and reads images of problems.
ORCHESTRATOR_MODEL=hf.co/unsloth/Qwen3.8-27B-GGUF:Q8_0
VISION_MODEL=hf.co/unsloth/Qwen3.8-27B-GGUF:Q8_0
# Local prover, used whenever no remote prover is configured or reachable.
PROVER_MODEL=hf.co/mradermacher/Goedel-Prover-V2-8B-GGUF:Q8_0
# Embedders for Mathlib retrieval (python3 -m src.mathlib_kb --build).
KB_EMBED_MODELS=nomic-embed-text,bge-m3,mxbai-embed-large

# Context window requested on Ollama's native API for the orchestrator and
# reviewer. Calls on /v1 get the server's OLLAMA_CONTEXT_LENGTH instead, so
# start Ollama with OLLAMA_CONTEXT_LENGTH=32768 as well (README, "Setup").
# NUM_CTX=131072

# --- Cloud planner (optional) ------------------------------------------------
# One call per problem to a large model before local work starts. Empty key =
# plan locally. Any OpenAI-compatible endpoint works via PLANNER_BASE.
DASHSCOPE_API_KEY=
# PLANNER_MODEL=qwen3.8-max
# PLANNER_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# --- Web search (optional, used only with --open) ----------------------------
SERPER_API_KEY=

# --- Remote prover on a GPU server (optional) --------------------------------
# Goedel-Prover-V2-32B served by vLLM (scripts/serve_goedel.sh) and reached
# through an SSH tunnel on port 8001. With GOEDEL_HOST set, the agent opens
# the tunnel and starts vLLM itself when the server is reachable but idle.
# ssh host or ~/.ssh/config alias of the GPU server
# GOEDEL_HOST=gpu-box
# PROVER_FALLBACK_BASE=http://127.0.0.1:8001/v1
# PROVER_FALLBACK_MODEL=Goedel-LM/Goedel-Prover-V2-32B
# Best-of-N in one request (vLLM honours `n`; Ollama does not).
# PROVER_BATCH_BASE=http://127.0.0.1:8001/v1
# PROVER_BATCH_MODEL=Goedel-LM/Goedel-Prover-V2-32B
# PROVER_BATCH_N=32

# --- Lean ------------------------------------------------------------------
# Written by scripts/setup_repl.sh. Without it every check pays `import Mathlib`.
# LEAN_REPL_PATH=
# Each REPL worker holds ~5.7 GB. One is safe next to local models on 64 GB.
LEAN_REPL_WORKERS=1
# Parallel rungs for the tactic pre-probe (CPU-bound).
TACTIC_WORKERS=8
# Reject proofs that rely on axioms beyond propext / Classical.choice /
# Quot.sound, or on native_decide.
AXIOM_AUDIT=1

# --- Effort ----------------------------------------------------------------
# Independent attempts per claim, self-correction rounds per attempt, seconds
# per claim, and seconds per problem in a batch (0 = unlimited).
PROVE_ATTEMPTS=5
PROVE_ROUNDS=6
PROVE_TIME_BUDGET=1800
PROBLEM_TIME_BUDGET=0
